generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Student {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  name          String
  studentPhone  String?
  fatherName    String?
  fatherPhone   String?
  motherName    String?
  motherPhone   String?
  notes         String?  // Profile notes

  // Relations
  enrollments       Enrollment[]
  attendance        Attendance[]
  grades            Grade[]
  complianceRecords ComplianceRecord[]
  payments          Payment[]
}

model Course {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())
  name          String
  description   String?
  status        String    // 'Active'/'Completed'
  startDate     DateTime
  endDate       DateTime?
  fee           Float
  maxPoints     Int       @default(100)
  requiredTasks Json      // Store the task array here

  // Relations
  enrollments Enrollment[]
  attendance  Attendance[]
  grades      Grade[]
  payments    Payment[]
}

model Enrollment {
  id                    String    @id @default(uuid())
  createdAt             DateTime  @default(now())
  studentId             String
  courseId              String
  status                String
  startDate             DateTime
  endDate               DateTime?
  completedDate         DateTime?
  paymentFollowUpLedger Json      // Store payment conversation history here

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
}

model Payment {
  id        String   @id @default(uuid())
  date      DateTime
  amount    Float
  method    String
  note      String?
  studentId String
  courseId  String

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
}

model Advance {
  id     String   @id @default(uuid())
  date   DateTime
  amount Float
  note   String?
}

model Attendance {
  id          String   @id @default(uuid())
  date        DateTime
  sessionId   String   // for grouping
  studentId   String
  courseId    String
  status      String
  sessionNote String?
  note        String?

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
}

model Grade {
  id             String   @id @default(uuid())
  date           DateTime
  studentId      String
  courseId       String
  taskId         String   // matches ID inside Course.requiredTasks
  score          Float
  feedback       String?
  submissionLink String?

  // Relations
  student Student @relation(fields: [studentId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])
}

model ComplianceRecord {
  id            String   @id @default(uuid())
  date          DateTime
  studentId     String
  violationType String
  status        String
  note          String?

  // Relations
  student Student @relation(fields: [studentId], references: [id])
}

model AppSetting {
  id                    String @id @default(uuid())
  teacherShare          Float
  courseDuration        Int
  complianceStrikeLimit Int    @default(3)
  jsonRules             Json   // Store other loose settings here
}
